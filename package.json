{
  "name": "wp-rest-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension to detect WordPress sites and explore their REST API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "web-ext build -s dist -a web-ext-artifacts --overwrite-dest",
    "start:firefox": "web-ext run -s dist",
    "lint:ext": "web-ext lint -s dist",
    "publish:amo": "web-ext sign -s dist -a web-ext-artifacts --channel listed"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/dompurify": "^3.0.5",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "web-ext": "^8.3.0"
  }
}
