{
  "manifest_version": 3,
  "name": "WP REST Explorer",
  "version": "0.1.0",
  "description": "Detects WordPress sites and provides a full explorer for browsing, querying and exporting their public REST API content.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_title": "WP REST Explorer"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "wp-rest-explorer@wordpress-explorer.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
